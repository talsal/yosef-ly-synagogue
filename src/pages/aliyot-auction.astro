---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, ALIYOT_AUCTION_API_URL } from '../data/site';
import { TORANIM_TABLE } from '../data/toranim';

const isConfigured = !ALIYOT_AUCTION_API_URL.includes('PASTE_');
// מיפוי תאריך -> שם פרשה, כדי לתייג באיזו שבת מדובר (לדוגמה: אחרי חג
// שמחת תורה, השבת הראשונה היא פרשת בראשית). מועבר ל-client-side כי
// ה-weekStart בפועל מחושב שם (תלוי בתאריך של המבקר, לא בזמן ה-build).
const parashaByDate = Object.fromEntries(TORANIM_TABLE.map((entry) => [entry.date, entry.parasha]));
---

<BaseLayout
	title="מכירה פומבית — עליות השבוע"
	description="מכירה פומבית מקוונת לעליות לתורה של השבת הקרובה"
	noindex
>
	<div class="container section">
		<h1>מכירה פומבית — עליות השבוע</h1>
		<p>
			מכל יום ראשון ועד יום שישי בשעה 10:00, אפשר להציע מחיר לכל אחת משבע העליות ולמפטיר. כל אחד
			יכול להעלות הצעה גבוהה יותר מהמוביל הנוכחי, בכל שלב עד הסגירה.
		</p>

		{isConfigured && <p id="parasha-line" class="parasha-line"></p>}

		{
			!isConfigured ? (
				<div class="card empty-state">
					<p>המכירה הפומבית עוד לא הופעלה בפועל. בקרוב.</p>
				</div>
			) : (
				<>
					<div id="loading-state" class="card empty-state">
						<p>טוען נתונים...</p>
					</div>
					<div id="error-state" class="card empty-state" hidden>
						<p>שגיאה בטעינת הנתונים. נסו לרענן את העמוד.</p>
					</div>
					<div id="closed-banner" class="card closed-banner" hidden>
						<p>המכירה נסגרה. להלן התוצאות הסופיות.</p>
						<button id="print-btn" type="button">הדפסה</button>
					</div>
					<div id="rows" class="rows-list"></div>
				</>
			)
		}

		<p class="contact-note">
			לשאלות יש לפנות דרך עמוד <a href={withBase('/contact')}>יצירת קשר</a>. להיסטוריית מכירות
			קודמות ראו את <a href={withBase('/aliyot')}>עמוד מכירת העליות</a>.
		</p>
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.parasha-line {
		font-weight: 700;
		color: var(--color-primary);
	}

	.closed-banner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		background: var(--color-accent-light);
		border-color: var(--color-accent);
	}

	.closed-banner[hidden] {
		display: none;
	}

	.closed-banner button {
		padding: 0.5rem 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		font-size: 0.95rem;
	}

	.rows-list {
		display: grid;
		gap: 0.75rem;
	}

	.rows-list :global(.aliyah-row) {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.rows-list :global(.aliyah-row .row-head) {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.rows-list :global(.aliyah-row .aliyah-label) {
		font-weight: 700;
		color: var(--color-primary);
		font-size: 1.1rem;
	}

	.rows-list :global(.aliyah-row .leader-line) {
		color: var(--color-text-muted);
		font-size: 0.95rem;
	}

	.rows-list :global(.aliyah-row .leader-line strong) {
		color: var(--color-accent);
	}

	.rows-list :global(.aliyah-row .bid-form) {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.rows-list :global(.aliyah-row .bid-form input[type='text']) {
		flex: 1 1 10rem;
	}

	.rows-list :global(.aliyah-row .bid-form input[type='number']) {
		width: 8rem;
	}

	.rows-list :global(.aliyah-row .bid-form input) {
		padding: 0.5rem 0.7rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		font-size: 1rem;
		background: var(--color-surface);
		color: var(--color-text);
	}

	.rows-list :global(.aliyah-row .bid-form button) {
		padding: 0.5rem 1rem;
		border-radius: var(--radius);
		border: none;
		background: var(--color-accent);
		color: white;
		cursor: pointer;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.rows-list :global(.aliyah-row .row-error) {
		color: #c0392b;
		font-size: 0.85rem;
		margin: 0;
		display: none;
	}

	.contact-note {
		margin-top: 1.5rem;
	}

	@media print {
		:global(header),
		:global(footer),
		.contact-note,
		p:first-of-type {
			display: none !important;
		}

		.rows-list :global(.bid-form) {
			display: none !important;
		}

		#closed-banner button {
			display: none !important;
		}
	}
</style>

{
	isConfigured && (
		<script define:vars={{ apiUrl: ALIYOT_AUCTION_API_URL, parashaByDate }}>
			const ALIYOT_ORDER = ['כהן', 'לוי', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שביעי', 'מפטיר'];

			const loadingEl = document.getElementById('loading-state');
			const errorEl = document.getElementById('error-state');
			const closedBannerEl = document.getElementById('closed-banner');
			const rowsEl = document.getElementById('rows');
			const printBtn = document.getElementById('print-btn');
			const parashaLineEl = document.getElementById('parasha-line');

			function renderParashaLine(weekStart) {
				if (!parashaLineEl) return;
				const parasha = parashaByDate[weekStart];
				const dateLabel = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' }).format(
					new Date(`${weekStart}T12:00:00`),
				);
				parashaLineEl.textContent = parasha ? `השבת הקרובה: פרשת ${parasha} (${dateLabel})` : `השבת הקרובה: ${dateLabel}`;
			}

			printBtn?.addEventListener('click', () => window.print());

			function escapeHtml(str) {
				return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
			}

			function renderRows(status) {
				const byAliyah = new Map(status.rows.map((r) => [r.aliyah, r]));

				rowsEl.innerHTML = ALIYOT_ORDER.map((aliyah) => {
					const row = byAliyah.get(aliyah) || { aliyah, name: '', price: 0 };
					const leaderLine = row.name
						? `מוביל כרגע: <strong>${escapeHtml(row.name)}</strong> — <strong>${row.price} ₪</strong>`
						: 'אין עדיין הצעות';

					const formHtml = status.isClosed
						? ''
						: `
							<div class="bid-form">
								<input type="text" class="name-input" placeholder="השם שלך" maxlength="60" />
								<input type="number" class="price-input" placeholder="ההצעה שלך (₪)" min="1" />
								<button type="button" class="bid-btn">הצע מחיר</button>
							</div>
							<p class="row-error"></p>
						`;

					return `
						<div class="card aliyah-row" data-aliyah="${escapeHtml(aliyah)}">
							<div class="row-head">
								<span class="aliyah-label">${escapeHtml(aliyah)}</span>
								<span class="leader-line">${leaderLine}</span>
							</div>
							${formHtml}
						</div>
					`;
				}).join('');

				if (!status.isClosed) {
					rowsEl.querySelectorAll('.aliyah-row').forEach((rowEl) => {
						const btn = rowEl.querySelector('.bid-btn');
						btn?.addEventListener('click', () => submitBid(rowEl, status.weekStart));
					});
				}
			}

			async function submitBid(rowEl, weekStart) {
				const aliyah = rowEl.dataset.aliyah;
				const nameInput = rowEl.querySelector('.name-input');
				const priceInput = rowEl.querySelector('.price-input');
				const errorEl2 = rowEl.querySelector('.row-error');

				const name = nameInput.value.trim();
				const price = Number(priceInput.value);
				errorEl2.style.display = 'none';

				if (!name) {
					errorEl2.textContent = 'צריך להזין שם';
					errorEl2.style.display = 'block';
					return;
				}
				if (!price || price <= 0) {
					errorEl2.textContent = 'צריך להזין הצעת מחיר תקינה';
					errorEl2.style.display = 'block';
					return;
				}

				try {
					const url = `${apiUrl}?action=bid&weekStart=${encodeURIComponent(weekStart)}&aliyah=${encodeURIComponent(aliyah)}&name=${encodeURIComponent(name)}&price=${encodeURIComponent(String(price))}`;
					const res = await fetch(url);
					const data = await res.json();

					if (!data.ok) {
						if (data.error === 'too-low') {
							errorEl2.textContent = `ההצעה חייבת להיות גבוהה מ-${data.current.price} ₪`;
							const leaderLineEl = rowEl.querySelector('.leader-line');
							if (leaderLineEl && data.current.name) {
								leaderLineEl.innerHTML = `מוביל כרגע: <strong>${escapeHtml(data.current.name)}</strong> — <strong>${data.current.price} ₪</strong>`;
							}
						} else if (data.error === 'closed' || data.error === 'stale-week') {
							errorEl2.textContent = 'המכירה נסגרה או שהעמוד לא מעודכן. רעננו את הדף.';
						} else {
							errorEl2.textContent = 'שגיאה בשליחת ההצעה. נסו שוב.';
						}
						errorEl2.style.display = 'block';
						return;
					}

					nameInput.value = '';
					priceInput.value = '';
					await loadStatus();
				} catch (err) {
					errorEl2.textContent = 'שגיאת רשת. נסו שוב.';
					errorEl2.style.display = 'block';
				}
			}

			async function loadStatus() {
				try {
					const res = await fetch(`${apiUrl}?action=status`);
					const data = await res.json();
					if (!data.ok) throw new Error('bad status');

					loadingEl.hidden = true;
					errorEl.hidden = true;
					closedBannerEl.hidden = !data.isClosed;
					renderParashaLine(data.weekStart);
					renderRows(data);
				} catch (err) {
					loadingEl.hidden = true;
					errorEl.hidden = false;
				}
			}

			loadStatus();
		</script>
	)
}
