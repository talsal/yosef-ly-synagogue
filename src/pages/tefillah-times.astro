---
import DailyZmanim from '../components/DailyZmanim.astro';
import HolidayList from '../components/HolidayList.astro';
import ShabbatSchedule from '../components/ShabbatSchedule.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { WEEKDAY_TIMES } from '../data/prayerTimes';
---

<BaseLayout title="זמני תפילות" description="לוח זמני תפילה לימות החול ולשבת בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>זמני תפילות</h1>

		<section class="section">
			<h2>לוח שבת שבועי</h2>
			<ShabbatSchedule />
		</section>

		<section class="section">
			<h2>ימות החול</h2>

			<div class="card special-weekday-times" id="special-weekday-times" hidden>
				<h3>זמני חול &ndash; עשרת ימי תשובה (עד ערב יום כיפור, כולל)</h3>
				<dl>
					<div><dt>סליחות</dt><dd>05:05</dd></div>
					<div><dt>קרבנות</dt><dd>05:55</dd></div>
					<div><dt>הודו</dt><dd>06:08</dd></div>
					<div><dt>מנחה</dt><dd>18:26</dd></div>
					<div><dt>אשרי</dt><dd>18:30</dd></div>
					<div><dt>ערבית</dt><dd>צמוד</dd></div>
				</dl>
			</div>

			<div class="grid weekday-grid" id="regular-weekday-times">
				<div class="card">
					<h3>קיץ</h3>
					<dl>
						<div><dt>שחרית</dt><dd>{WEEKDAY_TIMES.summer.shacharit || 'יעודכן בקרוב'}</dd></div>
						<div><dt>מנחה</dt><dd>{WEEKDAY_TIMES.summer.mincha || 'יעודכן בקרוב'}</dd></div>
						<div><dt>ערבית</dt><dd>{WEEKDAY_TIMES.summer.arvit || 'יעודכן בקרוב'}</dd></div>
					</dl>
				</div>
				<div class="card">
					<h3>חורף</h3>
					<dl>
						<div><dt>שחרית</dt><dd>{WEEKDAY_TIMES.winter.shacharit || 'יעודכן בקרוב'}</dd></div>
						<div><dt>מנחה</dt><dd>{WEEKDAY_TIMES.winter.mincha || 'יעודכן בקרוב'}</dd></div>
						<div><dt>ערבית</dt><dd>{WEEKDAY_TIMES.winter.arvit || 'יעודכן בקרוב'}</dd></div>
					</dl>
				</div>
			</div>
		</section>

		<section class="section">
			<h2>זמני היום</h2>
			<p class="section-note">מחושב לפי מיקום בית הכנסת המדויק בשכונת מוריה, מודיעין.</p>
			<DailyZmanim />
		</section>

		<section class="section">
			<h2>חגים ומועדים קרובים</h2>
			<HolidayList />
		</section>
	</div>
</BaseLayout>

<style>
	.section-note {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin-top: -0.5rem;
	}

	.weekday-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
	}

	.weekday-grid dl {
		margin: 0;
	}

	.weekday-grid dl > div {
		display: flex;
		justify-content: space-between;
		padding-block: 0.35rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.weekday-grid dt {
		color: var(--color-text-muted);
	}

	.weekday-grid dd {
		margin: 0;
		font-weight: 600;
	}

	.special-weekday-times {
		margin-bottom: 1rem;
		background: var(--color-accent-light);
		border-color: var(--color-accent);
	}

	.special-weekday-times dl {
		margin: 0.5rem 0 0;
	}

	.special-weekday-times dl > div {
		display: flex;
		justify-content: space-between;
		padding-block: 0.35rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.special-weekday-times dt {
		color: var(--color-text-muted);
	}

	.special-weekday-times dd {
		margin: 0;
		font-weight: 700;
		color: var(--color-primary);
	}
</style>

<script>
	import { toIsraelIsoDate } from '../lib/shabbatCompute';

	// זמני חול מיוחדים לעשרת ימי תשובה, כפי שנמסרו על ידי הקהילה — בתוקף
	// מ-15/09/2026 עד ערב יום כיפור (20/09/2026) כולל. אחרי התאריך הזה חוזרים
	// אוטומטית ללוח קיץ/חורף הרגיל, בלי צורך בהסרה ידנית.
	const ACTIVE_FROM = '2026-09-15';
	const ACTIVE_UNTIL = '2026-09-20';

	const todayIsrael = toIsraelIsoDate(new Date());
	if (todayIsrael >= ACTIVE_FROM && todayIsrael <= ACTIVE_UNTIL) {
		document.querySelector<HTMLElement>('#special-weekday-times')!.hidden = false;
		// .weekday-grid sets display:grid, which (being an author-stylesheet rule)
		// overrides the UA stylesheet's [hidden]{display:none} — so the hidden
		// property alone doesn't actually hide it. Force it via inline style instead.
		document.querySelector<HTMLElement>('#regular-weekday-times')!.style.display = 'none';
	}
</script>
