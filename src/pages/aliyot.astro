---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
import { LAST_ALIYOT_SALE } from '../data/aliyot';
---

<BaseLayout title="מכירת עליות לתורה" description="איך מתבצעת מכירת העליות לתורה בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>מכירת עליות לתורה</h1>

		<div class="card">
			<h2>איך זה עובד</h2>
			<p>
				מכירת העליות מתבצעת בעל פה בבית הכנסת, בכל שבת לפני קריאת התורה. הגבאי מכריז על כל
				עלייה, המתפללים מציעים מחיר בקול, והזוכה הוא מי שהציע את הסכום הגבוה ביותר. הגבאי רושם
				את התוצאות לאחר השבת.
			</p>
		</div>

		<section class="section">
			<h2>תוצאות המכירה האחרונה &ndash; פרשת {LAST_ALIYOT_SALE.parasha}</h2>
			<div class="card">
				<div class="sales-list">
					{
						LAST_ALIYOT_SALE.sales.map((sale) => (
							<div class="sale-row">
								<span class="aliyah-name">{sale.aliyah}</span>
								<span class="buyer-name">{sale.name || 'לא נמכר'}</span>
								<span class="price">{sale.price ? `${sale.price} ₪` : ''}</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<p class="contact-note">
			לשאלות על מכירת העליות יש לפנות דרך עמוד <a href={withBase('/contact')}>יצירת קשר</a>.
		</p>
	</div>
</BaseLayout>

<style>
	.sales-list {
		display: grid;
		gap: 0.25rem;
	}

	.sale-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.6rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.sale-row:last-child {
		border-bottom: none;
	}

	.aliyah-name {
		font-weight: 700;
		color: var(--color-primary);
		flex: 1;
	}

	.buyer-name {
		flex: 1.5;
		text-align: center;
	}

	.price {
		flex: 0.6;
		text-align: left;
		font-weight: 700;
		color: var(--color-accent);
	}

	.contact-note {
		margin-top: 1.5rem;
	}
</style>
