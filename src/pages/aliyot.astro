---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';

const entries = (await getCollection('aliyot')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...previous] = entries;

const dateFormat = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });

function totalOf(sales: { price: number | null }[]): number {
	return sales.reduce((sum, sale) => sum + (sale.price ?? 0), 0);
}

const monthFormat = new Intl.DateTimeFormat('he-IL', { month: 'long', year: 'numeric' });
const yearFormat = new Intl.DateTimeFormat('he-IL', { year: 'numeric' });

function summarize(
	list: typeof entries,
	keyOf: (date: Date) => string,
	formatter: Intl.DateTimeFormat,
): { label: string; total: number }[] {
	const order: string[] = [];
	const totals = new Map<string, number>();
	const labels = new Map<string, string>();

	for (const entry of list) {
		const key = keyOf(entry.data.date);
		if (!totals.has(key)) {
			order.push(key);
			labels.set(key, formatter.format(entry.data.date));
		}
		totals.set(key, (totals.get(key) ?? 0) + totalOf(entry.data.sales));
	}

	return order.map((key) => ({ label: labels.get(key)!, total: totals.get(key)! }));
}

const monthlySummary = summarize(entries, (d) => `${d.getFullYear()}-${d.getMonth()}`, monthFormat);
const yearlySummary = summarize(entries, (d) => `${d.getFullYear()}`, yearFormat);
---

<BaseLayout title="מכירת עליות לתורה" description="היסטוריית מכירת העליות לתורה בבית הכנסת יוסף-לי">
	<div class="container section">
		<p class="bsd">בס&quot;ד</p>
		<h1>מכירת עליות לתורה</h1>

		<div class="card">
			<h2>איך זה עובד</h2>
			<p>
				מכירת העליות מתבצעת בעל פה בבית הכנסת, בכל שבת לפני קריאת התורה. הגבאי מכריז על כל
				עלייה, המתפללים מציעים מחיר בקול, והזוכה הוא מי שהציע את הסכום הגבוה ביותר. הגבאי רושם
				את התוצאות לאחר השבת.
			</p>
		</div>

		{
			!latest ? (
				<p class="empty-state">אין כרגע תוצאות מכירה רשומות.</p>
			) : (
				<section class="section">
					<h2>תוצאות המכירה האחרונה &ndash; פרשת {latest.data.parasha} ({dateFormat.format(latest.data.date)})</h2>
					<div class="card">
						<div class="sales-list">
							{latest.data.sales.map((sale) => (
								<div class="sale-row">
									<span class="aliyah-name">{sale.aliyah}</span>
									<span class="buyer-name">{sale.name || 'לא נמכר'}</span>
									<span class="price">{sale.price ? `${sale.price} ₪` : ''}</span>
								</div>
							))}
							<div class="sale-row total-row">
								<span class="aliyah-name">סה&quot;כ</span>
								<span class="buyer-name"></span>
								<span class="price">{totalOf(latest.data.sales)} ₪</span>
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			entries.length > 0 && (
				<section class="section">
					<h2>סיכומים</h2>
					<div class="summaries-grid">
						<div class="card">
							<h3>לפי חודש</h3>
							<div class="summary-list">
								{monthlySummary.map((row) => (
									<div class="sale-row">
										<span class="aliyah-name">{row.label}</span>
										<span class="price">{row.total} ₪</span>
									</div>
								))}
							</div>
						</div>
						<div class="card">
							<h3>לפי שנה</h3>
							<div class="summary-list">
								{yearlySummary.map((row) => (
									<div class="sale-row">
										<span class="aliyah-name">{row.label}</span>
										<span class="price">{row.total} ₪</span>
									</div>
								))}
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			previous.length > 0 && (
				<section class="section">
					<h2>מכירות קודמות</h2>
					<div class="history-list">
						{previous.map((entry) => (
							<details class="card history-item">
								<summary>
									<span>פרשת {entry.data.parasha} &ndash; {dateFormat.format(entry.data.date)}</span>
									<span class="summary-total">סה&quot;כ {totalOf(entry.data.sales)} ₪</span>
								</summary>
								<div class="sales-list">
									{entry.data.sales.map((sale) => (
										<div class="sale-row">
											<span class="aliyah-name">{sale.aliyah}</span>
											<span class="buyer-name">{sale.name || 'לא נמכר'}</span>
											<span class="price">{sale.price ? `${sale.price} ₪` : ''}</span>
										</div>
									))}
									<div class="sale-row total-row">
										<span class="aliyah-name">סה&quot;כ</span>
										<span class="buyer-name"></span>
										<span class="price">{totalOf(entry.data.sales)} ₪</span>
									</div>
								</div>
							</details>
						))}
					</div>
				</section>
			)
		}

		<p class="contact-note">
			לשאלות על מכירת העליות יש לפנות דרך עמוד <a href={withBase('/contact')}>יצירת קשר</a>.
		</p>
	</div>
</BaseLayout>

<style>
	.bsd {
		margin: 0 0 0.5rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.empty-state {
		color: var(--color-text-muted);
	}

	.sales-list {
		display: grid;
		gap: 0.25rem;
	}

	.sale-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.6rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.sale-row:last-child {
		border-bottom: none;
	}

	.total-row {
		border-top: 2px solid var(--color-border);
		border-bottom: none;
		margin-top: 0.25rem;
		padding-top: 0.75rem;
	}

	.total-row .aliyah-name,
	.total-row .price {
		color: var(--color-accent);
	}

	.summaries-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
	}

	.summary-list {
		display: grid;
		gap: 0.25rem;
	}

	.summary-list .sale-row {
		justify-content: space-between;
	}

	.summary-list .price {
		flex: none;
	}

	.aliyah-name {
		font-weight: 700;
		color: var(--color-primary);
		flex: 1;
	}

	.buyer-name {
		flex: 1.5;
		text-align: center;
	}

	.price {
		flex: 0.6;
		text-align: left;
		font-weight: 700;
		color: var(--color-accent);
	}

	.history-list {
		display: grid;
		gap: 0.75rem;
	}

	.history-item {
		margin: 0;
	}

	.history-item summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--color-primary);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.summary-total {
		color: var(--color-accent);
	}

	.history-item .sales-list {
		margin-top: 0.75rem;
	}

	.contact-note {
		margin-top: 1.5rem;
	}
</style>
