---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';

const names = await getCollection('refuah');
---

<BaseLayout title="רפואות" description="רשימת שמות לתפילה לרפואה שלמה בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>רפואות &ndash; מי שברך</h1>
		<p>רשימת השמות שהקהילה מתפללת עבורם לרפואה שלמה.</p>

		{
			names.length === 0 ? (
				<p class="empty-state">הרשימה תתעדכן כאן בקרוב.</p>
			) : (
				<div class="refuah-list">
					{names.map(({ data }) => (
						<span class="refuah-name">
							{data.hebrewName}
							{data.motherHebrewName && ` בן/בת ${data.motherHebrewName}`}
						</span>
					))}
				</div>
			)
		}

		<section class="card request-form">
			<h2>בקשה להוספת שם</h2>
			<p>
				מטעמי פרטיות, הוספת שם לרשימה אינה מתפרסמת ישירות באתר אלא מועברת לאישור הגבאי.
				<!-- TODO: לחבר טופס בקשה אמיתי (Google Form) ולעדכן כאן קישור/הטמעה -->
			</p>
			<a class="button" href={withBase('/contact')}>לפנייה לגבאי</a>
		</section>
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.refuah-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		margin: 1rem 0;
	}

	.refuah-name {
		flex: 1 1 14rem;
		padding-block: 0.25rem;
		display: block;
	}

	.refuah-name::before {
		content: '• ';
		color: var(--color-accent);
	}

	.request-form {
		margin-top: 2rem;
	}
</style>
