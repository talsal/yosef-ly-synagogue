---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const memorials = (await getCollection('memorials')).sort(
	(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
---

<BaseLayout title="אזכרות" description="אזכרות קרובות בקהילת בית הכנסת יוסף-לי">
	<div class="container section">
		<h1>אזכרות</h1>
		<p>רשימת האזכרות הקרובות. לתיאום אזכרה יש לפנות לאיש הקשר המצוין.</p>

		{
			memorials.length === 0 ? (
				<p class="empty-state">אין כרגע אזכרות קרובות מפורסמות.</p>
			) : (
				<div class="memorials-list">
					{memorials.map(({ data }) => (
						<div class="memorial-row">
							<strong>{data.name}</strong>
							<span>{data.hebrewDate}</span>
							{data.contact && <span>{data.contact}</span>}
						</div>
					))}
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.memorial-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--color-border);
	}
</style>
