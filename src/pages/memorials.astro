---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MEMORIALS_FORM_URL } from '../data/site';
---

<BaseLayout title="אזכרות" description="אזכרות קרובות בקהילת בית הכנסת יוסף-לי">
	<div class="container section">
		<h1>אזכרות</h1>
		<p>רשימת האזכרות שנרשמו על ידי חברי הקהילה.</p>

		<a class="button" href={MEMORIALS_FORM_URL} target="_blank" rel="noopener noreferrer">
			רישום אזכרה חדשה
		</a>

		<div class="memorials-list" aria-live="polite">
			<p class="loading-state">טוען אזכרות...</p>
		</div>
	</div>
</BaseLayout>

<style>
	.button {
		display: inline-block;
		margin: 1rem 0 1.5rem;
	}

	.loading-state,
	:global(.error-state) {
		color: var(--color-text-muted);
	}

	.memorials-list {
		display: grid;
		gap: 1rem;
	}

	.memorials-list :global(.memorial-card) {
		margin: 0;
	}

	.memorials-list :global(dl) {
		margin: 0;
		display: grid;
		gap: 0.4rem;
	}

	.memorials-list :global(dl > div) {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.memorials-list :global(dt) {
		color: var(--color-text-muted);
	}

	.memorials-list :global(dd) {
		margin: 0;
		font-weight: 600;
	}
</style>

<script>
	import { MEMORIALS_SHEET_CSV_URL } from '../data/site';
	import { fetchSheetRows } from '../lib/csv';

	async function render() {
		const container = document.querySelector<HTMLElement>('.memorials-list');
		if (!container) return;

		try {
			const rows = await fetchSheetRows(MEMORIALS_SHEET_CSV_URL);
			if (rows.length === 0) {
				container.innerHTML = '<p class="error-state">אין כרגע אזכרות רשומות.</p>';
				return;
			}

			container.innerHTML = rows
				.map(
					(row) => `
						<div class="card memorial-card">
							<dl>
								<div><dt>שם הנפטר/ת</dt><dd>${row['שם הנפטר/ת (ושם האב/אם אם נהוג)'] ?? ''}</dd></div>
								<div><dt>תאריך הפטירה העברי</dt><dd>${row['תאריך הפטירה העברי'] ?? ''}</dd></div>
								<div><dt>בן/בת משפחה מהקהילה</dt><dd>${row['שם בן/בת המשפחה מהקהילה'] ?? ''}</dd></div>
								<div><dt>קשר לנפטר/ת</dt><dd>${row['מה הקשר שלך לנפטר/ת? (למשל: סבתא, אבא, אח)'] ?? ''}</dd></div>
							</dl>
						</div>
					`,
				)
				.join('');
		} catch {
			container.innerHTML = '<p class="error-state">אירעה שגיאה בטעינת הרשימה. נסו לרענן את העמוד.</p>';
		}
	}

	render();
</script>
