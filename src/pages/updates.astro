---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('updates');
const updates = await Promise.all(
	entries
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
		.map(async (entry) => ({ entry, rendered: await render(entry) })),
);

const dateFormat = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="עדכונים" description="עדכוני קהילה אחרונים מבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>עדכונים</h1>
		<p>פיד ההודעות והחדשות האחרונות של הקהילה.</p>

		{
			updates.length === 0 ? (
				<p class="empty-state">אין כרגע עדכונים חדשים.</p>
			) : (
				<div class="updates-list">
					{updates.map(({ entry, rendered: { Content } }) => (
						<article class="card update-card">
							<p class="update-date">{dateFormat.format(entry.data.date)}</p>
							<h2>{entry.data.title}</h2>
							<Content />
						</article>
					))}
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.updates-list .update-card {
		margin-bottom: 1rem;
	}

	.update-date {
		color: var(--color-accent);
		font-weight: 700;
		font-size: 0.9rem;
	}

	.update-card h2 {
		margin: 0.2rem 0 0.4rem;
		font-size: 1.1rem;
	}

	.update-card :global(p) {
		max-width: none;
	}
</style>
