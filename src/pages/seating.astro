---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
import seatingFloorPlan from '../assets/images/seating-floor-plan-mens.png';
---

<BaseLayout title="מקומות ישיבה" description="חיפוש מקום הישיבה שלך באולם התפילה, לפי סידור ההושבה של חברי העמותה">
	<div class="container section">
		<h1>מקומות ישיבה</h1>
		<p>
			מתפלל יקר, הזן את שמך למטה ותוכל לדעת באיזה כיסא/כיסאות אתה יושב, לפי סידור ההושבה של
			חברי העמותה.
		</p>
		<p class="note">
			החיפוש מכסה כרגע רק את עזרת הגברים. לצפייה בסידור המלא ראו את
			<a href={withBase('/updates')}>עמוד העדכונים</a>.
		</p>

		<div class="search-row">
			<div class="search-box">
				<label for="name-search">חיפוש לפי שם (שם משפחה ושם פרטי, בכל סדר)</label>
				<input id="name-search" type="text" placeholder="לדוגמה: כהן דוד" autocomplete="off" />
			</div>

			<div class="search-box">
				<label for="seat-search">חיפוש לפי מספר כיסא</label>
				<input id="seat-search" type="text" placeholder="לדוגמה: 37" autocomplete="off" inputmode="decimal" />
			</div>
		</div>

		<div class="results" aria-live="polite">
			<p class="hint-state">הקלידו שם או מספר כיסא כדי לראות תוצאות.</p>
		</div>

		<div class="map-section" hidden>
			<h2>מיקום על המפה</h2>
			<p class="map-note">עזרת הגברים, מבט מלמעלה. הכיסא/כיסאות שנמצאו מסומנים באדום.</p>
			<div class="map-wrapper">
				<Image src={seatingFloorPlan} alt="מפת עזרת הגברים עם מספרי הכיסאות" widths={[600, 960, 1400]} sizes="(min-width: 60rem) 50rem, 100vw" />
				<div class="pins-layer"></div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.note {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.search-row {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin: 1.5rem 0;
	}

	.search-box {
		display: grid;
		gap: 0.4rem;
		max-width: 24rem;
		flex: 1 1 16rem;
	}

	.search-box label {
		font-weight: 600;
	}

	.search-box input {
		padding: 0.6rem 0.8rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		font-size: 1rem;
		background: var(--color-surface);
		color: var(--color-text);
	}

	.results {
		display: grid;
		gap: 0.75rem;
	}

	.hint-state,
	:global(.empty-state) {
		color: var(--color-text-muted);
	}

	.results :global(.seat-card) {
		margin: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.results :global(.seat-card .seat-name) {
		font-weight: 600;
	}

	.results :global(.seat-card .seat-numbers) {
		color: var(--color-accent);
		font-weight: 700;
	}

	.map-section {
		margin-top: 2rem;
	}

	.map-note {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.map-wrapper {
		position: relative;
		max-width: 50rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.map-wrapper :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.pins-layer {
		position: absolute;
		inset: 0;
	}

	.pins-layer :global(.map-pin) {
		position: absolute;
		width: 1.4rem;
		height: 1.4rem;
		margin-left: -0.7rem;
		margin-top: -0.7rem;
		border-radius: 50%;
		background: rgba(220, 38, 38, 0.55);
		border: 2px solid #dc2626;
		box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.2);
	}
</style>

<script>
	import { MENS_SEATING, VACANT_SEATS } from '../data/seating';
	import { escapeHtml } from '../lib/csv';
	import { SEAT_MAP_POSITIONS } from '../data/seatingMap';

	const nameInput = document.querySelector<HTMLInputElement>('#name-search');
	const seatInput = document.querySelector<HTMLInputElement>('#seat-search');
	const results = document.querySelector<HTMLElement>('.results');
	const mapSection = document.querySelector<HTMLElement>('.map-section');
	const pinsLayer = document.querySelector<HTMLElement>('.pins-layer');

	const seatToName = new Map<string, string>();
	for (const entry of MENS_SEATING) {
		for (const seat of entry.seats) {
			seatToName.set(seat, entry.name);
		}
	}

	function updateMap(matches: (typeof MENS_SEATING)[number][]) {
		if (!mapSection || !pinsLayer) return;

		const seats = [...new Set(matches.flatMap((entry) => entry.seats))];
		if (seats.length === 0) {
			mapSection.hidden = true;
			pinsLayer.innerHTML = '';
			return;
		}

		pinsLayer.innerHTML = seats
			.map((seat) => {
				const pos = SEAT_MAP_POSITIONS[seat];
				if (!pos) return '';
				return `<div class="map-pin" style="left:${pos.left}%;top:${pos.top}%" title="כיסא ${escapeHtml(seat)}"></div>`;
			})
			.join('');
		mapSection.hidden = false;
	}

	function renderHint() {
		if (!results) return;
		results.innerHTML = '<p class="hint-state">הקלידו שם או מספר כיסא כדי לראות תוצאות.</p>';
		updateMap([]);
	}

	function renderByName() {
		if (!nameInput || !results) return;
		const query = nameInput.value.trim();

		if (!query) {
			renderHint();
			return;
		}

		const tokens = query.split(/\s+/).filter(Boolean);
		const matches = MENS_SEATING.filter((entry) =>
			tokens.every((token) => entry.name.includes(token)),
		);

		if (matches.length === 0) {
			results.innerHTML = '<p class="empty-state">לא נמצא מתפלל בשם זה בעזרת הגברים.</p>';
			updateMap([]);
			return;
		}

		results.innerHTML = matches
			.map((entry) => {
				const seatWord = entry.seats.length > 1 ? 'כיסאות' : 'כיסא';
				return `
					<div class="card seat-card">
						<span class="seat-name">${escapeHtml(entry.name)}</span>
						<span class="seat-numbers">${seatWord} ${entry.seats.map(escapeHtml).join(', ')}</span>
					</div>
				`;
			})
			.join('');
		updateMap(matches);
	}

	function renderBySeat() {
		if (!seatInput || !results) return;
		const seat = seatInput.value.trim();

		if (!seat) {
			renderHint();
			return;
		}

		const name = seatToName.get(seat);
		if (name) {
			results.innerHTML = `
				<div class="card seat-card">
					<span class="seat-name">${escapeHtml(name)}</span>
					<span class="seat-numbers">כיסא ${escapeHtml(seat)}</span>
				</div>
			`;
			updateMap([{ name, seats: [seat] }]);
			return;
		}

		if (VACANT_SEATS.includes(seat)) {
			results.innerHTML = `<p class="empty-state">כיסא ${escapeHtml(seat)} פנוי, אינו משויך לאף מתפלל כרגע.</p>`;
			updateMap([{ name: '', seats: [seat] }]);
			return;
		}

		if (SEAT_MAP_POSITIONS[seat]) {
			// מספר כיסא תקין על המפה אך לא הופיע ברשימת התפוסים/הפנויים -- מקרה קצה, נציג בכל זאת
			results.innerHTML = `<p class="empty-state">לא נמצא שיוך לכיסא ${escapeHtml(seat)}.</p>`;
			updateMap([{ name: '', seats: [seat] }]);
			return;
		}

		results.innerHTML = `<p class="empty-state">מספר כיסא ${escapeHtml(seat)} אינו קיים בעזרת הגברים.</p>`;
		updateMap([]);
	}

	nameInput?.addEventListener('input', () => {
		if (seatInput) seatInput.value = '';
		renderByName();
	});

	seatInput?.addEventListener('input', () => {
		if (nameInput) nameInput.value = '';
		renderBySeat();
	});
</script>
