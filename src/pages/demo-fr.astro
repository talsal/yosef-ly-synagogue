---
import { Image } from 'astro:assets';
import exteriorFullTwilight from '../assets/images/exterior-full-twilight.jpeg';
import '../styles/global.css';
import { withBase } from '../data/site';

const LIVE_SITE_URL = 'https://talsal.github.io/yosef-ly-synagogue/';

const features = [
	{
		icon: '🕯️',
		title: 'Horaires de prière et de fêtes, à jour',
		body: 'Les horaires de Shabbat et de semaine se calculent automatiquement selon la date — personne n’a besoin de penser à mettre à jour le site juste parce que l’heure a changé.',
	},
	{
		icon: '🔎',
		title: 'Recherche de place assise',
		body: 'Les membres cherchent leur propre nom — ou le numéro de place de quelqu’un d’autre — sur un plan visuel de la salle, au lieu d’appeler le secrétariat.',
	},
	{
		icon: '📝',
		title: 'Formulaires en libre-service',
		body: 'Listes de mémoriaux et de rétablissement que les membres remplissent eux-mêmes — sans intermédiaire, sans attendre qu’un bénévole relaie un message WhatsApp.',
	},
	{
		icon: '⚡',
		title: 'Mises à jour hebdomadaires en quelques minutes',
		body: 'Les résultats de vente d’alyot de la semaine ou un changement de tour de service passent d’un message WhatsApp abrégé à une mise à jour publiée en quelques minutes, pas en quelques jours.',
	},
	{
		icon: '♿',
		title: 'Accessibilité intégrée',
		body: 'Conforme WCAG 2.1 AA dès le premier jour — contraste correct, étiquettes pour lecteurs d’écran, navigation au clavier — pas ajoutée après une plainte.',
	},
	{
		icon: '📣',
		title: 'Un espace publicitaire de bon goût',
		body: 'Un emplacement rotatif pour les commerces tenus par des membres de la communauté, conçu pour s’harmoniser avec le site plutôt que de ressembler à une bannière générique — une petite source réelle de financement pour l’entretien.',
	},
];
---

<!doctype html>
<html lang="fr" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Un vrai site web de synagogue, en direct, construit par Tal Salman — étude de cas et page de contact pour d'autres communautés."
		/>
		<title>Des sites web pour synagogues, faits pour être utilisés | Tal Salman</title>
	</head>
	<body>
		<header class="page-header">
			<div class="container header-inner">
				<span class="wordmark">Tal Salman</span>
				<div class="header-links">
					<a class="header-lang" href={withBase('/demo-en')}>English</a>
					<a class="header-lang" href={withBase('/demo-he')}>עברית</a>
					<a class="header-cta" href="#contact">Me contacter</a>
				</div>
			</div>
		</header>

		<main>
			<section class="hero container">
				<p class="eyebrow">Étude de cas &mdash; בית הכנסת יוסף-לי, Modi&rsquo;in, Israël</p>
				<h1>Je conçois des sites web pour synagogues que les communautés utilisent vraiment chaque semaine.</h1>
				<p class="hero-sub">
					Pas un énième site-modèle générique, adapté à toutes les communautés de la même façon.
					Un vrai site avec les horaires de Shabbat à jour automatiquement, une recherche de
					place assise, des formulaires en libre-service, et un processus qui transforme un
					message WhatsApp en mise à jour publiée en quelques minutes &mdash; construit et
					activement maintenu pour une communauté bien réelle.
				</p>
				<div class="hero-actions">
					<a class="button" href={LIVE_SITE_URL} target="_blank" rel="noopener noreferrer">
						Voir le site en direct &rarr;
					</a>
					<a class="button button-outline" href="#contact">Me contacter</a>
				</div>
			</section>

			<section class="container browser-section">
				<div class="browser-frame">
					<div class="browser-chrome">
						<span class="browser-dot"></span>
						<span class="browser-dot"></span>
						<span class="browser-dot"></span>
						<span class="browser-url">talsal.github.io/yosef-ly-synagogue</span>
					</div>
					<div class="browser-body" dir="rtl" lang="he">
						<Image
							src={exteriorFullTwilight}
							alt="בית הכנסת יוסף-לי בשעת בין הערביים"
							widths={[400, 700, 1000]}
							sizes="(min-width: 60rem) 50rem, 100vw"
							class="browser-photo"
						/>
						<div class="browser-overlay">
							<p class="browser-eyebrow">שכונת מוריה, מודיעין</p>
							<p class="browser-title">בית הכנסת יוסף-לי</p>
						</div>
					</div>
				</div>
				<p class="browser-caption">
					Un aperçu de la vraie page d’accueil &mdash; cliquez ci-dessus pour la voir en direct,
					dans son intégralité.
				</p>
			</section>

			<section class="container features-section">
				<h2>Ce qu’il y a vraiment dedans</h2>
				<div class="features-grid">
					{
						features.map((f) => (
							<div class="feature-card">
								<span class="feature-icon" aria-hidden="true">
									{f.icon}
								</span>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="container proof-section">
				<div class="proof-card">
					<h2>Ce n’est pas une maquette</h2>
					<ul class="proof-list">
						<li>En ligne depuis août 2026, activement utilisé chaque semaine par une vraie congrégation.</li>
						<li>Contenu mis à jour à partir de vrais messages WhatsApp &mdash; le processus réel qu’utilise une synagogue.</li>
						<li>
							Amélioré à partir de données d’usage réelles, pas de suppositions &mdash; trafic,
							clics et taux de rebond orientent ce qui est construit ensuite.
						</li>
					</ul>
				</div>
			</section>

			<section class="container contact-section" id="contact">
				<div class="contact-card">
					<h2>Vous voulez quelque chose comme ça pour votre communauté ?</h2>
					<p>
						Je construis et maintiens des sites comme celui-ci pour des synagogues &mdash;
						parlez-moi un peu de votre communauté et de vos besoins, et nous trouverons ce qui
						convient.
					</p>
					<div class="contact-links">
						<a class="button" href="mailto:tal.salman@gmail.com">tal.salman@gmail.com</a>
						<a class="button button-outline" href="tel:+972505991972">+972 50-599-1972</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="page-footer">
			<div class="container">
				<p>Construit par Tal Salman &middot; cette page et l’exemple en direct sont tous deux du vrai code, fonctionnel.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	body {
		direction: ltr;
		text-align: left;
	}

	.page-header {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1rem;
	}

	.wordmark {
		font-weight: 800;
		color: var(--color-primary);
		font-size: 1.1rem;
	}

	.header-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.header-lang {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.header-lang:hover {
		color: var(--color-accent);
	}

	.header-cta {
		font-weight: 700;
		text-decoration: none;
	}

	.hero {
		padding-block: 3.5rem 2.5rem;
		max-width: 46rem;
	}

	.eyebrow {
		color: var(--color-accent);
		font-weight: 700;
		letter-spacing: 0.02em;
		max-width: none;
	}

	.hero h1 {
		font-size: clamp(2rem, 4.5vw, 2.9rem);
		text-wrap: balance;
		margin-top: 0.5rem;
	}

	.hero-sub {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		max-width: 42rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.button-outline {
		background: transparent;
		border: 2px solid var(--color-primary);
		color: var(--color-primary);
	}

	.button-outline:hover {
		background: var(--color-primary);
		color: #fff;
	}

	.browser-section {
		padding-block: 1rem 3rem;
	}

	.browser-frame {
		border-radius: calc(var(--radius) * 1.2);
		overflow: hidden;
		border: 1px solid var(--color-border);
		box-shadow: 0 20px 45px -25px rgba(20, 29, 53, 0.4);
		max-width: 50rem;
		margin-inline: auto;
	}

	.browser-chrome {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.65rem 0.85rem;
		background: var(--color-accent-light);
		border-bottom: 1px solid var(--color-border);
	}

	.browser-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--color-border);
	}

	.browser-url {
		margin-inline-start: 0.75rem;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.2rem 0.85rem;
	}

	.browser-body {
		position: relative;
	}

	.browser-photo {
		width: 100%;
		aspect-ratio: 16 / 8;
		object-fit: cover;
		filter: brightness(0.6);
	}

	.browser-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-inline: 2rem;
		color: #fff;
	}

	.browser-eyebrow {
		color: var(--color-accent-light);
		font-weight: 700;
		max-width: none;
		margin: 0 0 0.3rem;
	}

	.browser-title {
		font-size: clamp(1.5rem, 4vw, 2.2rem);
		font-weight: 800;
		max-width: none;
		margin: 0;
	}

	.browser-caption {
		text-align: center;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin-top: 0.85rem;
		max-width: none;
	}

	.features-section {
		padding-block: 2.5rem;
	}

	.features-section h2,
	.proof-section h2,
	.contact-section h2 {
		text-align: center;
	}

	.features-grid {
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		margin-top: 2rem;
	}

	.feature-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.5rem;
	}

	.feature-icon {
		font-size: 1.75rem;
		display: block;
		margin-bottom: 0.5rem;
	}

	.feature-card h3 {
		margin: 0 0 0.4rem;
		color: var(--color-primary);
		font-size: 1.1rem;
	}

	.feature-card p {
		color: var(--color-text-muted);
		margin: 0;
		font-size: 0.95rem;
	}

	.proof-section {
		padding-block: 1rem 2.5rem;
	}

	.proof-card {
		background: linear-gradient(140deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
		color: #f7f2e4;
		border-radius: var(--radius);
		padding: 2.5rem;
		max-width: 42rem;
		margin-inline: auto;
		text-align: center;
	}

	.proof-card h2 {
		color: #fff;
		margin-top: 0;
	}

	.proof-list {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.85rem;
		text-align: left;
	}

	.proof-list li {
		padding-inline-start: 1.5rem;
		position: relative;
		color: rgba(247, 242, 228, 0.9);
	}

	.proof-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 800;
	}

	.contact-section {
		padding-block: 1rem 4rem;
	}

	.contact-card {
		text-align: center;
		max-width: 34rem;
		margin-inline: auto;
	}

	.contact-card p {
		color: var(--color-text-muted);
		margin-inline: auto;
	}

	.contact-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.page-footer {
		border-top: 1px solid var(--color-border);
		padding-block: 1.5rem;
		color: var(--color-text-muted);
		font-size: 0.85rem;
		text-align: center;
	}

	.page-footer p {
		max-width: none;
	}
</style>
