---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="אירועים" description="אירועים קרובים בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>אירועים</h1>
		<p>רשימת האירועים הקרובים של הקהילה, מעודכנת על ידי המתנדבים.</p>

		<!--
			עמודות הגיליון (events): title, date, category, description
			ראו EVENTS_SHEET_CSV_URL ב-src/data/site.ts
		-->
		<div class="events-list" aria-live="polite">
			<p class="loading-state">טוען אירועים...</p>
		</div>
	</div>
</BaseLayout>

<style>
	.loading-state,
	:global(.error-state) {
		color: var(--color-text-muted);
	}

	.events-list :global(.event-card) {
		margin-bottom: 1rem;
	}

	.events-list :global(.event-card h2) {
		margin: 0 0 0.25rem;
		font-size: 1.15rem;
	}

	.events-list :global(.event-date) {
		color: var(--color-accent);
		font-weight: 700;
	}

	.events-list :global(p) {
		max-width: none;
	}
</style>

<script>
	import { EVENTS_SHEET_CSV_URL } from '../data/site';
	import { renderSheetList } from '../lib/sheetList';

	renderSheetList(
		'.events-list',
		EVENTS_SHEET_CSV_URL,
		(row) => `
			<div class="card event-card">
				<p class="event-date">${row.date ?? ''} ${row.category ? `&middot; ${row.category}` : ''}</p>
				<h2>${row.title ?? ''}</h2>
				${row.description ? `<p>${row.description}</p>` : ''}
			</div>
		`,
		'אין כרגע אירועים קרובים מפורסמים. עקבו אחרינו לעדכונים.',
	);
</script>
