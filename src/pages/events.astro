---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('events');
const events = await Promise.all(
	entries
		.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
		.map(async (entry) => ({ entry, rendered: await render(entry) })),
);

const dateFormat = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="אירועים" description="אירועים קרובים בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>אירועים</h1>
		<p>רשימת האירועים הקרובים של הקהילה.</p>

		{
			events.length === 0 ? (
				<p class="empty-state">אין כרגע אירועים קרובים מפורסמים. עקבו אחרינו לעדכונים.</p>
			) : (
				<div class="events-list">
					{events.map(({ entry, rendered: { Content } }) => (
						<article class="card event-card">
							<p class="event-date">
								{dateFormat.format(entry.data.date)}
								{entry.data.category && <> &middot; {entry.data.category}</>}
							</p>
							<h2>{entry.data.title}</h2>
							<Content />
						</article>
					))}
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.events-list .event-card {
		margin-bottom: 1rem;
	}

	.event-card h2 {
		margin: 0 0 0.25rem;
		font-size: 1.15rem;
	}

	.event-date {
		color: var(--color-accent);
		font-weight: 700;
	}

	.event-card :global(p) {
		max-width: none;
	}
</style>
