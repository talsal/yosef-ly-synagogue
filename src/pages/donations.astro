---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORG_NAME, withBase } from '../data/site';
---

<BaseLayout title="תרומות" description="איך תורמים לבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>תרומות</h1>
		<p>
			כל תרומה מסייעת לקהילה להשלים את המעבר למבנה החדש ולתחזק את פעילות בית הכנסת. תרומות
			מתקבלות דרך {ORG_NAME}.
		</p>

		<section class="card">
			<h2>העברה בנקאית / ביט</h2>
			<!-- TODO: להשלים פרטי חשבון בנק וביט אמיתיים -->
			<dl class="details">
				<div><dt>בנק</dt><dd>יעודכן בקרוב</dd></div>
				<div><dt>סניף וחשבון</dt><dd>יעודכן בקרוב</dd></div>
				<div><dt>ביט</dt><dd>יעודכן בקרוב</dd></div>
			</dl>
			<p class="note">
				לקבלה לצורכי מס יש לציין שם מלא ודרך יצירת קשר בהעברה, או לפנות אלינו ב<a href={withBase('/contact')}
					>יצירת קשר</a
				>.
			</p>
		</section>

		<section class="card">
			<h2>ייעודי תרומה</h2>
			<ul>
				<li>תרומה כללית לבית הכנסת</li>
				<li>הנצחה &ndash; לעילוי נשמת (לע&quot;נ)</li>
				<li>תרומה לרפואת &ndash; לרפואה שלמה</li>
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.details {
		margin: 1rem 0;
	}

	.details div {
		display: flex;
		justify-content: space-between;
		padding-block: 0.4rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.details dt {
		color: var(--color-text-muted);
	}

	.details dd {
		margin: 0;
		font-weight: 600;
	}

	.note {
		color: var(--color-text-muted);
		font-size: 0.95rem;
	}

	section.card {
		margin-bottom: 1.5rem;
	}
</style>
