---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
import { TORANIM_TABLE } from '../data/toranim';

const dateFormat = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
const todayIso = new Date().toISOString().slice(0, 10);
const upcoming = TORANIM_TABLE.find((entry) => entry.date >= todayIso) ?? null;
---

<BaseLayout title="תורנים" description="לוח תורני הקידוש בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>תורנים</h1>

		<div class="card">
			<h2>מהי תורנות קידוש?</h2>
			<p>
				התורנים אחראים על הכנת הקידוש לאחר התפילה בשבת &ndash; אוכל, שתייה וסידור. התורנות
				מתחלפת כל שבת בין זוגות קבועים מהקהילה, לפי המחזור שבטבלה למטה.
			</p>
			<p>
				מי שצריך להחליף תורנות עם מישהו אחר (או שיש לו שאלה על התורנות שלו), מוזמן לפנות דרך
				עמוד <a href={withBase('/contact')}>יצירת קשר</a>, ואנחנו נעדכן כאן בהתאם.
			</p>
		</div>

		{
			upcoming && (
				<section class="section">
					<h2>השבת הקרובה &ndash; פרשת {upcoming.parasha} ({dateFormat.format(new Date(`${upcoming.date}T12:00:00`))})</h2>
					<div class="card upcoming-card">
						{upcoming.pair ? (
							<div class="pair">
								<span>{upcoming.pair[0]}</span>
								<span>{upcoming.pair[1]}</span>
							</div>
						) : (
							<p class="empty-state">אין תורנות השבת (חג).</p>
						)}
					</div>
				</section>
			)
		}

		<section class="section">
			<h2>לוח התורנים המלא</h2>
			<div class="toranim-list">
				{TORANIM_TABLE.map((entry) => (
					<div class:list={['card toranim-row', { 'is-upcoming': upcoming && entry.date === upcoming.date }]}>
						<div class="toranim-info">
							<span class="parasha">{entry.parasha}</span>
							<span class="date">{dateFormat.format(new Date(`${entry.date}T12:00:00`))}</span>
						</div>
						<div class="toranim-names">
							{entry.pair ? (
								<>
									<span>{entry.pair[0]}</span>
									<span>{entry.pair[1]}</span>
								</>
							) : (
								<span class="empty-state">אין תורנות (חג)</span>
							)}
						</div>
					</div>
				))}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.upcoming-card .pair {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-accent);
	}

	.toranim-list {
		display: grid;
		gap: 0.6rem;
	}

	.toranim-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin: 0;
	}

	.toranim-row.is-upcoming {
		border-color: var(--color-accent);
		background: var(--color-accent-light);
	}

	.toranim-info {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.toranim-info .parasha {
		font-weight: 700;
		color: var(--color-primary);
	}

	.toranim-info .date {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.toranim-names {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		font-weight: 600;
	}
</style>
