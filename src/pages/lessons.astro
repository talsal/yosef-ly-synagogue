---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const DAY_ORDER: Record<string, number> = {
	'ימים א׳–ה׳': -1,
	'יום ראשון': 0,
	'יום שני': 1,
	'יום שלישי': 2,
	'יום רביעי': 3,
	'יום חמישי': 4,
	'יום שישי': 5,
	שבת: 6,
};

// זמן טקסט חופשי ("20:30", "20:00–21:30", "לפני מנחה") -- ממיר לדקות מתחילת
// היום לצורך מיון; טקסט שלא מתחיל בשעה מספרית (כמו "לפני מנחה") מסודר אחרון
// בתוך אותו יום, לא לפני שיעורים עם שעה ידועה.
function timeSortKey(time: string): number {
	const match = time.match(/^(\d{1,2}):(\d{2})/);
	if (!match) return Infinity;
	return Number(match[1]) * 60 + Number(match[2]);
}

type Lesson = CollectionEntry<'lessons'>;

function byDayThenTime(a: Lesson, b: Lesson): number {
	const dayDiff = (DAY_ORDER[a.data.day] ?? 99) - (DAY_ORDER[b.data.day] ?? 99);
	if (dayDiff !== 0) return dayDiff;
	return timeSortKey(a.data.time) - timeSortKey(b.data.time);
}

const lessons = (await getCollection('lessons')).sort(byDayThenTime);

// קיבוץ לפי יום, בסדר הימים, כדי שבטבלה כל יום יופיע בכותרת משלו
const dayGroups: { day: string; entries: Lesson[] }[] = [];
for (const lesson of lessons) {
	const group = dayGroups.find((g) => g.day === lesson.data.day);
	if (group) group.entries.push(lesson);
	else dayGroups.push({ day: lesson.data.day, entries: [lesson] });
}

function notesOf(data: Lesson['data']): string {
	return [data.audience, data.location, data.note].filter(Boolean).join(' · ');
}
---

<BaseLayout title="שיעורי תורה" description="שיעורי התורה הקבועים בבית הכנסת יוסף-לי">
	<div class="container section">
		<h1>שיעורי תורה</h1>
		<p>
			רשימת השיעורים הקבועים בקהילה. מנוהל בקוד האתר &mdash; לעדכון פנו למתנדב הטכני של הקהילה.
		</p>

		{
			dayGroups.length === 0 ? (
				<p class="empty-state">אין כרגע שיעורים רשומים.</p>
			) : (
				<div class="table-wrap">
					<table class="lessons-table" aria-label="לוח השיעורים השבועי">
						<thead>
							<tr>
								<th scope="col">שעה</th>
								<th scope="col">נושא</th>
								<th scope="col">מעביר</th>
								<th scope="col">הערות</th>
							</tr>
						</thead>
						{dayGroups.map((group) => (
							<tbody>
								<tr class="day-row">
									<th scope="colgroup" colspan="4">{group.day}</th>
								</tr>
								{group.entries.map(({ data }) => (
									<tr>
										<td data-label="שעה" class="time">{data.time}</td>
										<td data-label="נושא" class="topic">{data.topic}</td>
										<td data-label="מעביר">{data.teacher}</td>
										<td data-label="הערות" class="notes">{notesOf(data)}</td>
									</tr>
								))}
							</tbody>
						))}
					</table>
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.empty-state {
		color: var(--color-text-muted);
	}

	.table-wrap {
		margin-top: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		overflow: hidden;
	}

	.lessons-table {
		width: 100%;
		border-collapse: collapse;
		text-align: right;
	}

	.lessons-table thead th {
		padding: 0.75rem 1rem;
		background: var(--color-primary);
		color: #fff;
		font-weight: 700;
	}

	.lessons-table td {
		padding: 0.7rem 1rem;
		border-top: 1px solid var(--color-border);
		vertical-align: top;
	}

	.lessons-table .day-row th {
		padding: 0.5rem 1rem;
		background: var(--color-accent-light);
		color: var(--color-primary);
		font-weight: 700;
		border-top: 1px solid var(--color-border);
	}

	.lessons-table .time {
		white-space: nowrap;
		font-weight: 700;
		color: var(--color-accent);
	}

	.lessons-table .topic {
		font-weight: 600;
	}

	.lessons-table .notes {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	@media (max-width: 40rem) {
		.lessons-table thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}

		.lessons-table,
		.lessons-table tbody,
		.lessons-table tr,
		.lessons-table td,
		.lessons-table .day-row th {
			display: block;
		}

		.lessons-table tr:not(.day-row) {
			padding: 0.6rem 1rem;
			border-top: 1px solid var(--color-border);
		}

		.lessons-table td {
			display: flex;
			gap: 0.75rem;
			padding: 0.2rem 0;
			border-top: none;
		}

		.lessons-table td::before {
			content: attr(data-label);
			flex: 0 0 4rem;
			color: var(--color-text-muted);
			font-size: 0.85rem;
		}

		.lessons-table td.notes:empty {
			display: none;
		}
	}
</style>
