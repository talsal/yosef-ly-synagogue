---
// לוח שבת שבועי: כניסת/יציאת שבת ופרשה נשלפים אוטומטית מ-Hebcal, ושאר הלוח
// (שיעורים, מנחה, סעודה שלישית וכו') מחושב מהם אוטומטית — ראו lib/shabbatCompute.ts.
// אין צורך בגיליון חיצוני; תורני הקידוש בלבד מעודכנים ידנית בקוד (לא ניתן לחשב שם אדם).
import { withBase } from '../data/site';
---

<section class="card shabbat-schedule" aria-live="polite">
	<p class="loading-state">טוען את לוח השבת...</p>
</section>

<template id="shabbat-schedule-template">
	<h3 class="parasha"></h3>
	<p class="times-summary"></p>

	<div class="schedule-columns">
		<div>
			<h4>ליל שבת</h4>
			<dl>
				<div><dt>שיר השירים</dt><dd data-field="shir_hashirim_time"></dd></div>
				<div><dt>מנחה/כניסת שבת</dt><dd data-field="mincha_candle_time"></dd></div>
			</dl>
		</div>

		<div>
			<h4>שבת</h4>
			<dl>
				<div><dt>שיעור לפני שחרית</dt><dd data-field="shiur_before_shacharit"></dd></div>
				<div><dt>שחרית</dt><dd data-field="shacharit_time"></dd></div>
				<div><dt>קידוש &mdash; תורנים</dt><dd data-field="kiddush_toranim"></dd></div>
				<div><dt>שיעור אחרי קידוש</dt><dd data-field="shiur_after_kiddush"></dd></div>
				<div><dt>שיעור אחה"צ</dt><dd data-field="shiur_afternoon"></dd></div>
			</dl>
			<p class="toranim-note">
				* לא לשכוח להביא גבינות מהולי בייגל ולשים בקירור במחסן. יש לתאם הגעה מראש עם איציק
				0542567787
			</p>
			<a class="toranim-link" href={withBase('/toranim')}>לוח התורנים המלא ולתיאום החלפות &larr;</a>
		</div>

		<div>
			<h4>מנחה וערב</h4>
			<dl>
				<div><dt>מנחה של שבת</dt><dd data-field="mincha_shabbat"></dd></div>
				<div><dt>סעודה שלישית</dt><dd data-field="seuda_shlishit"></dd></div>
				<div><dt>ערבית מוצאי שבת קודש</dt><dd data-field="arvit_motzash"></dd></div>
			</dl>
		</div>
	</div>

	<p class="signature">רב הקהילה הרב אופיר בן סעדון והוועד</p>
</template>

<template id="special-schedule-template">
	<h3 class="special-title"></h3>
	<div class="special-days"></div>
	<p class="signature special-note"></p>
</template>

<template id="special-day-template">
	<div class="special-day">
		<h4></h4>
		<dl></dl>
	</div>
</template>

<template id="special-item-template">
	<div><dt></dt><dd></dd></div>
</template>

<style>
	.shabbat-schedule {
		display: grid;
		gap: 1rem;
	}

	.loading-state,
	.error-state {
		color: var(--color-text-muted);
	}

	.parasha {
		margin: 0;
	}

	.times-summary {
		font-weight: 700;
		color: var(--color-accent);
		max-width: none;
	}

	.schedule-columns {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
	}

	.schedule-columns h4 {
		margin: 0 0 0.5rem;
		color: var(--color-primary);
	}

	dl {
		margin: 0;
	}

	dl > div {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding-block: 0.35rem;
		border-bottom: 1px dashed var(--color-border);
	}

	dt {
		color: var(--color-text-muted);
	}

	dd {
		margin: 0;
		font-weight: 600;
		text-align: left;
	}

	.toranim-note {
		margin: 0.5rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}

	.toranim-link {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.signature {
		text-align: center;
		color: var(--color-text-muted);
		font-style: italic;
		margin-top: 0.5rem;
		max-width: none;
	}

	.special-title {
		margin: 0 0 0.5rem;
		text-align: center;
	}

	.special-days {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	.special-day h4 {
		margin: 0 0 0.5rem;
		color: var(--color-primary);
	}

	.special-note {
		font-style: normal;
	}
</style>

<script>
	import { fetchShabbatTimes } from '../lib/hebcal';
	import { computeWeeklySchedule, toIsraelIsoDate, type WeeklySchedule } from '../lib/shabbatCompute';
	import { SPECIAL_SCHEDULES } from '../data/specialSchedule';

	const CSV_FIELDS = [
		'shiur_before_shacharit',
		'shacharit_time',
		'kiddush_toranim',
		'shiur_after_kiddush',
		'shiur_afternoon',
		'shir_hashirim_time',
		'mincha_candle_time',
		'mincha_shabbat',
		'seuda_shlishit',
		'arvit_motzash',
	] as const satisfies readonly (keyof WeeklySchedule)[];

	function renderSpecial(container: HTMLElement, special: (typeof SPECIAL_SCHEDULES)[number]) {
		const specialTemplate = document.querySelector<HTMLTemplateElement>('#special-schedule-template');
		const dayTemplate = document.querySelector<HTMLTemplateElement>('#special-day-template');
		const itemTemplate = document.querySelector<HTMLTemplateElement>('#special-item-template');
		if (!specialTemplate || !dayTemplate || !itemTemplate) return;

		const fragment = specialTemplate.content.cloneNode(true) as DocumentFragment;
		fragment.querySelector('.special-title')!.textContent = special.title;
		fragment.querySelector('.special-note')!.textContent = special.closingNote;

		const daysContainer = fragment.querySelector('.special-days')!;
		for (const day of special.days) {
			const dayFragment = dayTemplate.content.cloneNode(true) as DocumentFragment;
			dayFragment.querySelector('h4')!.textContent = `${day.label} – ${day.dateLabel}`;
			const dl = dayFragment.querySelector('dl')!;
			for (const item of day.items) {
				const itemFragment = itemTemplate.content.cloneNode(true) as DocumentFragment;
				itemFragment.querySelector('dt')!.textContent = item.time;
				itemFragment.querySelector('dd')!.textContent = item.text;
				dl.appendChild(itemFragment);
			}
			daysContainer.appendChild(dayFragment);
		}

		container.replaceChildren(fragment);
	}

	async function render() {
		const container = document.querySelector<HTMLElement>('.shabbat-schedule');
		if (!container) return;

		// בדיקת לוח מיוחד (חג) קודם, לפי טווח תאריכים בלבד — בלי תלות
		// ב"הדלקת הנרות הקרובה" של Hebcal, כדי לא להישבר כשהיא מתקדמת ליום ב' של חג
		const todayIsrael = toIsraelIsoDate(new Date());
		const special = SPECIAL_SCHEDULES.find(
			(s) => todayIsrael >= s.activeFrom && todayIsrael <= s.activeUntil,
		);
		if (special) {
			renderSpecial(container, special);
			return;
		}

		const shabbatTimes = await fetchShabbatTimes().catch(() => null);

		if (!shabbatTimes) {
			const base = import.meta.env.BASE_URL.endsWith('/')
				? import.meta.env.BASE_URL
				: `${import.meta.env.BASE_URL}/`;
			container.innerHTML = `<p class="error-state">לא ניתן לטעון כרגע את לוח השבת. אפשר לפנות אלינו ב<a href="${base}contact">יצירת קשר</a>.</p>`;
			return;
		}

		const template = document.querySelector<HTMLTemplateElement>('#shabbat-schedule-template');
		if (!template) return;

		const fragment = template.content.cloneNode(true) as DocumentFragment;

		const parashaEl = fragment.querySelector('.parasha')!;
		const summaryEl = fragment.querySelector('.times-summary')!;

		// shabbatTimes.parasha מגיע כבר עם הקידומת "פרשת" מ-Hebcal (למשל "פרשת נח")
		parashaEl.textContent = shabbatTimes.parasha || 'לוח השבת';
		summaryEl.textContent = `כניסת שבת ${shabbatTimes.candleLighting} · יציאת שבת ${shabbatTimes.havdalah}`;

		const schedule = computeWeeklySchedule(shabbatTimes.candleLightingDate, shabbatTimes.havdalahDate);
		for (const field of CSV_FIELDS) {
			const el = fragment.querySelector(`[data-field="${field}"]`);
			if (el) el.textContent = schedule[field];
		}

		container.replaceChildren(fragment);
	}

	render();
</script>
