---

<div class="holiday-list card" aria-live="polite">
	<p class="loading-state">טוען חגים קרובים...</p>
</div>

<style>
	.loading-state,
	.error-state {
		color: var(--color-text-muted);
		margin: 0;
	}

	.holiday-list ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	.holiday-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.4rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.holiday-list .date {
		color: var(--color-text-muted);
	}
</style>

<script>
	import { fetchUpcomingHolidays } from '../lib/holidays';

	function formatDate(iso: string): string {
		return new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(
			new Date(iso),
		);
	}

	async function render() {
		const container = document.querySelector<HTMLElement>('.holiday-list');
		if (!container) return;

		const holidays = await fetchUpcomingHolidays().catch(() => []);

		if (holidays.length === 0) {
			container.innerHTML = '<p class="error-state">לא ניתן לטעון כרגע את לוח החגים.</p>';
			return;
		}

		const items = holidays
			.map((h) => `<li><span>${h.title}</span><span class="date">${formatDate(h.date)}</span></li>`)
			.join('');
		container.innerHTML = `<ul>${items}</ul>`;
	}

	render();
</script>
