---
// באנר פרסומות מתחלף לעסקי קהילה. סקיצה לבדיקה מקומית בלבד. הפאנל בנוי
// בגוונים של המותג (כחול-נייבי + זהב) כדי שירגיש כמו חלק מהאתר ולא כמו
// באנר פרסומות גנרי שהודבק עליו. מציג עסק אחד בכל פעם ומתחלף אוטומטית;
// לחיצה על הבאנר פותחת את קישור המפרסם.
import { COMMUNITY_BUSINESSES } from '../data/communityBusinesses';
---

{
	COMMUNITY_BUSINESSES.length > 0 && (
		<div class="ad-banner" id="ad-banner">
			<div class="ad-edge" aria-hidden="true" />
			<span class="ad-label">פרסומת</span>
			<div class="ad-slides">
				{COMMUNITY_BUSINESSES.map((biz, i) => (
					<a
						class="ad-slide"
						class:list={[{ active: i === 0 }]}
						href={biz.contactHref}
						target="_blank"
						rel="noopener noreferrer sponsored"
						data-ad-name={biz.name}
					>
						<span class="ad-main">
							<span class="ad-icon" style={`background: ${biz.accent}`}>
								{biz.icon}
							</span>
							<span class="ad-text">
								<span class="ad-category">{biz.category}</span>
								<span class="ad-name">{biz.name}</span>
								<span class="ad-desc">{biz.description}</span>
							</span>
						</span>
						<span class="ad-cta">{biz.contactLabel} &larr;</span>
					</a>
				))}
			</div>
			{COMMUNITY_BUSINESSES.length > 1 && (
				<div class="ad-dots">
					{COMMUNITY_BUSINESSES.map((_, i) => (
						<span class="ad-dot" class:list={[{ active: i === 0 }]} />
					))}
				</div>
			)}
		</div>
	)
}

<style>
	.ad-banner {
		position: relative;
		display: flex;
		border-radius: var(--radius);
		overflow: hidden;
		background: linear-gradient(140deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
		box-shadow: 0 12px 28px -16px rgba(20, 29, 53, 0.55);
	}

	.ad-edge {
		flex-shrink: 0;
		width: 0.3rem;
		background: var(--color-accent);
	}

	.ad-label {
		position: absolute;
		top: 0.85rem;
		left: 1.1rem;
		font-size: 0.7rem;
		font-weight: 700;
		color: #d9c48d;
		letter-spacing: 0.06em;
		z-index: 2;
	}

	.ad-slides {
		position: relative;
		flex: 1;
		min-height: 9.5rem;
	}

	@media (min-width: 40rem) {
		.ad-slides {
			min-height: 7.5rem;
		}
	}

	.ad-slide {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		text-decoration: none;
		color: #f7f2e4;
		padding: 1.9rem 1.25rem 1.2rem;
		gap: 0.6rem;
		opacity: 0;
		transform: translateY(0.35rem);
		pointer-events: none;
		transition:
			opacity 0.5s ease,
			transform 0.5s ease;
	}

	.ad-slide.active {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	@media (min-width: 40rem) {
		.ad-slide {
			flex-direction: row;
			align-items: center;
			padding: 1.25rem 2rem;
			gap: 1.5rem;
		}
	}

	.ad-main {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.85rem;
		width: 100%;
		min-width: 0;
	}

	@media (min-width: 40rem) {
		.ad-main {
			flex: 1;
		}
	}

	.ad-icon {
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		font-size: 1.25rem;
		box-shadow: 0 4px 10px -3px rgba(0, 0, 0, 0.4);
	}

	@media (min-width: 40rem) {
		.ad-icon {
			width: 3.25rem;
			height: 3.25rem;
			font-size: 1.5rem;
		}
	}

	.ad-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		flex: 1;
	}

	.ad-category {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: #d9c48d;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ad-name {
		font-size: 1.05rem;
		font-weight: 800;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (min-width: 40rem) {
		.ad-name {
			font-size: 1.25rem;
		}
	}

	.ad-desc {
		font-size: 0.8rem;
		color: rgba(247, 242, 228, 0.78);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (min-width: 40rem) {
		.ad-desc {
			font-size: 0.9rem;
			-webkit-line-clamp: 2;
		}
	}

	.ad-cta {
		flex-shrink: 0;
		font-weight: 700;
		font-size: 0.82rem;
		background: var(--color-accent);
		color: #fff;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius);
		white-space: nowrap;
		transition: background 0.2s ease;
	}

	@media (min-width: 40rem) {
		.ad-cta {
			font-size: 0.9rem;
			padding: 0.6rem 1.4rem;
		}
	}

	.ad-slide:hover .ad-cta {
		background: #c9a24b;
	}

	.ad-dots {
		position: absolute;
		bottom: 0.7rem;
		inset-inline: 0;
		display: flex;
		justify-content: center;
		gap: 0.4rem;
		z-index: 2;
	}

	.ad-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: rgba(247, 242, 228, 0.35);
		transition: background 0.3s ease;
	}

	.ad-dot.active {
		background: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.ad-slide {
			transition-duration: 0.01ms;
		}
	}
</style>

<script>
	declare global {
		interface Window {
			gtag?: (...args: unknown[]) => void;
		}
	}

	const banner = document.querySelector<HTMLElement>('#ad-banner');
	if (banner) {
		const slides = [...banner.querySelectorAll<HTMLElement>('.ad-slide')];
		const dots = [...banner.querySelectorAll<HTMLElement>('.ad-dot')];
		let index = 0;

		if (slides.length > 1) {
			setInterval(() => {
				slides[index]?.classList.remove('active');
				dots[index]?.classList.remove('active');
				index = (index + 1) % slides.length;
				slides[index]?.classList.add('active');
				dots[index]?.classList.add('active');
			}, 4000);
		}

		for (const slide of slides) {
			slide.addEventListener('click', () => {
				window.gtag?.('event', 'ad_click', {
					business_name: slide.dataset.adName ?? '',
				});
			});
		}
	}
</script>
